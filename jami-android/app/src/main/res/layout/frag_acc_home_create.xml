<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_background"
    android:clipChildren="false"
    tools:context=".account.AccountWizardActivity">

    <cx.ring.views.CubistView
        android:id="@+id/welcome_painting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <cx.ring.views.BoundedLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp"
            app:bounded_width="480dp">

            <!-- Reserves the upper ~45% of the page for the Cubist painting -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3.4" />

            <TextView
                android:id="@+id/welcome_title"
                style="@style/Welcome.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/welcome_title" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/welcome_claims"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:flexWrap="wrap"
                app:justifyContent="center">

                <TextView
                    style="@style/Welcome.Claim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_claim_no_phone" />

                <TextView
                    style="@style/Welcome.Claim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_claim_no_email" />

                <TextView
                    style="@style/Welcome.Claim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_claim_no_ads" />

                <TextView
                    style="@style/Welcome.Claim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_claim_no_stolen_data" />

                <TextView
                    style="@style/Welcome.Claim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_claim_no_algorithm" />

                <TextView
                    style="@style/Welcome.Claim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_claim_totally_free" />

            </com.google.android.flexbox.FlexboxLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ring_create_btn"
                style="@style/Welcome.Cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/account_new_get_started" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/existing_account_btn"
                style="@style/Welcome.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/account_already_have" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/advanced_btn"
                style="@style/Welcome.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_advanced_show" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.35" />

            <ImageView
                android:layout_width="156dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                app:srcCompat="@drawable/jami_full_logo" />

        </cx.ring.views.BoundedLinearLayout>

    </ScrollView>

</FrameLayout>
