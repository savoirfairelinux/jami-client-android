<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/invitation_group"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/padding_large"
    android:visibility="invisible"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/bottom_sheet_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/invitation_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/padding_large">

        <ImageView
            android:id="@+id/invitation_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/background_pending_accent"
            android:importantForAccessibility="no"
            android:padding="@dimen/padding_small"
            android:src="@drawable/new_invitation"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/invitation_received_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/invitation_card_title"
                android:textAppearance="@style/TextAppearance.Jami.PendingTitle"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/invitation_received_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_xsmall"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Jami.PendingSupporting"
                android:textColor="@color/textColorSecondary"
                tools:text="Emile, Linda, Damien" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/invitation_badge"
            style="@style/Widget.Jami.PendingCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="4" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/padding_small"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pending_chevron"
            app:tint="?attr/colorControlNormal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pending_list_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/pending_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/abc_ic_ab_back_material"
            app:navigationContentDescription="@string/wizard_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="@string/invitation_card_title"
            app:titleTextAppearance="@style/TextAppearance.Jami.PendingTitle"
            app:titleTextColor="?attr/colorOnSurface">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/pending_count"
                style="@style/Widget.Jami.PendingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/padding_large"
                tools:text="4" />
        </com.google.android.material.appbar.MaterialToolbar>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:dividerColor="?attr/colorOutlineVariant" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pending_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/padding_small"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_pending_request" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
