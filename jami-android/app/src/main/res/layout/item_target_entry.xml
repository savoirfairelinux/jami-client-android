<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- 1. Avatar of the target (contact, group, circle, board), with a contact's presence badge -->
    <ImageView
        android:id="@+id/target_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        tools:src="@drawable/outline_person_24" />

    <!-- 2. Icon of the target type (contact, group, circle, board) -->
    <ImageView
        android:id="@+id/target_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="12dp"
        android:padding="5dp"
        android:background="@drawable/background_unread_counter"
        android:backgroundTint="?attr/colorSurfaceVariant"
        app:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@null"
        tools:src="@drawable/outline_person_24" />

    <!-- 3. Name of the target -->
    <TextView
        android:id="@+id/target_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="12dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Alice" />

    <!-- 4. "Chat" icon (Message / Document / etc. mode) -->
    <FrameLayout
        android:id="@+id/target_action"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:clipChildren="false">

        <!-- Pulses while the contact sends its position, from around the button
             rather than from under it, where it would hardly show -->
        <View
            android:id="@+id/target_pulse"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/pulse_ring"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/target_chat_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:background="@drawable/background_unread_counter"
            android:backgroundTint="?attr/colorPrimaryContainer"
            android:src="@drawable/baseline_chat_24"
            app:tint="?attr/colorOnPrimaryContainer"
            android:contentDescription="@string/function_messages" />
    </FrameLayout>

    <!-- 4b. Video and audio call icons (Call mode) -->
    <ImageView
        android:id="@+id/target_video_call_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:padding="8dp"
        android:background="@drawable/background_unread_counter"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:src="@drawable/baseline_videocam_24"
        app:tint="?attr/colorOnPrimaryContainer"
        android:visibility="gone"
        android:contentDescription="@string/ab_action_video_call" />

    <ImageView
        android:id="@+id/target_audio_call_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:background="@drawable/background_unread_counter"
        android:backgroundTint="?attr/colorSecondaryContainer"
        android:src="@drawable/baseline_call_24"
        app:tint="?attr/colorOnSecondaryContainer"
        android:visibility="gone"
        android:contentDescription="@string/ab_action_audio_call" />

</LinearLayout>
