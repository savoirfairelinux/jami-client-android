<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/file_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@id/audioInfoLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/textmsg_bg_in"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="216dp">

        <com.google.android.material.button.MaterialButton
            android:id="@id/play"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/control_play"
            android:gravity="center"
            android:paddingHorizontal="0dp"
            app:icon="@drawable/play_arrow_24px"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <cx.ring.views.WaveformView
            android:id="@id/audio_waveform"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1" />

        <TextView
            android:id="@id/msg_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
