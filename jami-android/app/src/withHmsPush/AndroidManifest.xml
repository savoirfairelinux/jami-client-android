<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".application.JamiApplicationHms"
        tools:ignore="UnusedAttribute">

        <!-- Declared inline instead of through agconnect-services.json, so the build needs
             no generated credential file and the AGConnect Gradle plugin stays out. -->
        <meta-data
            android:name="com.huawei.hms.client.appid"
            android:value="appid=${hmsAppId}" />

        <service
            android:name=".services.JamiHmsMessagingService"
            android:stopWithTask="false"
            android:exported="false">
            <intent-filter>
                <action android:name="com.huawei.push.action.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name="cx.ring.service.PushForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|remoteMessaging">
        </service>

    </application>

</manifest>
