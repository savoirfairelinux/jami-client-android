# -*- mode: ruby; -*-
# Customise this file, documentation can be found here:
# https://github.com/fastlane/fastlane/tree/master/fastlane/docs
# All available actions: https://github.com/fastlane/fastlane/blob/master/fastlane/docs/Actions.md
# can also be listed using the `fastlane actions` command

# Change the syntax highlighting to Ruby
# All lines starting with a # are ignored when running `fastlane`

# If you want to automatically update fastlane if a new version is available:
# update_fastlane
opt_out_usage
skip_docs

# This is the minimum version number required.
# Update this, if you use features of a newer version
fastlane_version "2.13.0"

default_platform :android

platform :android do

  # Google Play reviews all pending changes of an app as a single batch.
  # Submitting again while a review is in progress cancels the pending
  # submission and restarts the review from scratch. Never run a publishing
  # lane while "Changes in review" is non-empty on the Play Console
  # publishing overview page.

  desc "Build the signed Play Store bundle"
  private_lane :build_bundle do |options|
    gradle(
      task: "bundle",
      flavor: "withFirebase",
      build_type: "Release",
      print_command: false,
      project_dir: 'jami-android',
      properties: {
        "android.injected.signing.store.file" => options[:keystore_path],
        "android.injected.signing.store.password" => options[:storepass],
        "android.injected.signing.key.alias" => options[:keyalias],
        "android.injected.signing.key.password" => options[:keypass],
      }
    )
  end

  desc "Submit a new Build to the Google Play Store"
  lane :playstore do |options|
    build_bundle(options)

    upload_to_play_store(
      track: options[:store_track],
      json_key: options[:json_key],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Submit a new Beta Build to the Play Store Beta channel"
  lane :beta do |options|
    build_bundle(options)

    upload_to_play_store(
      track: "beta",
      json_key: options[:json_key],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote the bundle already reviewed on beta to the production channel"
  lane :production do |options|
    # Promote the exact artifact Google already reviewed on the beta channel
    # rather than building and submitting a second, different bundle. A
    # rebuild produces a new artifact that needs its own full review, which
    # doubles the number of reviews and makes the two channels overlap.
    version_code = options[:version_code] ||
      google_play_track_version_codes(
        track: "beta",
        json_key: options[:json_key]
      ).max

    UI.user_error!("No version code on the beta channel to promote") if version_code.nil?
    UI.message("Promoting version code #{version_code} from beta to production")

    upload_to_play_store(
      track: "beta",
      track_promote_to: "production",
      version_code: version_code,
      json_key: options[:json_key],
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "So far, we just sign and align the APK"
  lane :ci do |options|
    gradle(
      task: "assemble",
      flavor: "noPush",
      build_type: "Release",
      print_command: false,
      project_dir: 'jami-android',
      properties: {
        "android.injected.signing.store.file" => options[:keystore_path],
        "android.injected.signing.store.password" => options[:storepass],
        "android.injected.signing.key.alias" => options[:keyalias],
        "android.injected.signing.key.password" => options[:keypass],
      }
    )
  end

end
